{
  "manifest_version": 3,
  "name": "جت‌سئو نیوز",
  "short_name": "JetSEO News",
  "description": "سوژه‌یابی برای تحریریه‌ها: سوژه‌های داغ رسانه‌ها، خبرهایی که رقبا زده‌اند و شما نه، و ترندهای گوگل و ویکی‌پدیا.",
  "version": "0.3.0",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "جت‌سئو نیوز",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "sidePanel", "alarms", "notifications"],
  "host_permissions": [
    "https://coreapi.jetseo.ir/*",
    "https://www.jetseo.ir/*",
    "https://jetseo.ir/*",
    "https://trends.google.com/*"
  ],
  "minimum_chrome_version": "116"
}
